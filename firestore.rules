rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is a member or master root of the org
    function isOrgMember(orgId) {
      return isSignedIn() && (
        orgId == null ||
        // Allow if user is master root of the organization
        get(/databases/$(database)/documents/organizations/$(orgId)).data.masterRootUserId == request.auth.uid ||
        // Allow if user is in the organization's member list
        (request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.memberUids) ||
        // Allow if user has an active assignment in this org
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
      );
    }

    // Helper function for write: checks incoming orgId
    function canWriteToOrg(orgId) {
      return isSignedIn() && isOrgMember(orgId);
    }

    match /organizations/{orgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.masterRootUserId == request.auth.uid ||
        request.resource.data.masterRootUserId == request.auth.uid
      );

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/organizations/$(orgId)).data.masterRootUserId == request.auth.uid ||
          request.auth.uid == memberId
        );
      }
    }

    match /departments/{deptId} {
      allow read: if isSignedIn() && (resource == null || isOrgMember(resource.data.orgId));
      allow create: if isSignedIn() && canWriteToOrg(request.resource.data.orgId);
      allow update, delete: if isSignedIn() && isOrgMember(resource.data.orgId);
    }

    match /roles/{roleId} {
      allow read: if isSignedIn() && (resource == null || isOrgMember(resource.data.orgId));
      allow create: if isSignedIn() && canWriteToOrg(request.resource.data.orgId);
      allow update, delete: if isSignedIn() && isOrgMember(resource.data.orgId);
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn() && (resource == null || isOrgMember(resource.data.orgId));
      allow create: if isSignedIn() && canWriteToOrg(request.resource.data.orgId);
      allow update, delete: if isSignedIn() && isOrgMember(resource.data.orgId);
    }

    match /comments/{commentId} {
      allow read: if isSignedIn() && (resource == null || !('orgId' in resource.data) || isOrgMember(resource.data.orgId));
      allow create: if isSignedIn() && (!('orgId' in request.resource.data) || canWriteToOrg(request.resource.data.orgId));
      allow update, delete: if isSignedIn() && (!('orgId' in resource.data) || isOrgMember(resource.data.orgId));
    }

    match /files/{fileId} {
      allow read: if isSignedIn() && (resource == null || isOrgMember(resource.data.orgId));
      allow create: if isSignedIn() && canWriteToOrg(request.resource.data.orgId);
      allow update, delete: if isSignedIn() && isOrgMember(resource.data.orgId);
    }

    match /meetings/{meetingId} {
      allow read: if isSignedIn() && (resource == null || isOrgMember(resource.data.orgId));
      allow create: if isSignedIn() && canWriteToOrg(request.resource.data.orgId);
      allow update, delete: if isSignedIn() && isOrgMember(resource.data.orgId);
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isOrgMember(resource.data.orgId));
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isOrgMember(resource.data.orgId));
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && (resource == null || !('orgId' in resource.data) || isOrgMember(resource.data.orgId));
      allow create: if isSignedIn() && (!('orgId' in request.resource.data) || canWriteToOrg(request.resource.data.orgId));
      allow update, delete: if isSignedIn() && (!('orgId' in resource.data) || isOrgMember(resource.data.orgId));
    }

    match /integration_connections/{connId} {
      allow read: if isSignedIn() && (resource == null || isOrgMember(resource.data.orgId));
      allow create: if isSignedIn() && canWriteToOrg(request.resource.data.orgId);
      allow update, delete: if isSignedIn() && isOrgMember(resource.data.orgId);
    }

    match /user_compliance/{complianceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
